<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tezgah v2 / Osman board (desktop_agent/web/board.css) ile eslenmis tokenlar -->
    <Color x:Key="AppBackground">#0A0C10</Color>
    <Color x:Key="PanelBackground">#0D0F14</Color>
    <Color x:Key="PanelHeaderBackground">#12151B</Color>
    <Color x:Key="CardBackground">#161A21</Color>
    <Color x:Key="AccentColor">#A9F1FE</Color>
    <Color x:Key="TextColor">#F1F5F9</Color>
    <Color x:Key="ChartTrack">#1E232B</Color>
    <Color x:Key="ChartFill">#A9F1FE</Color>
    <Color x:Key="MutedText">#7C8798</Color>
    <Color x:Key="DownColor">#5C8A69</Color>
    <Color x:Key="UpColor">#C48B5E</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0A0C10"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#0D0F14"/>
    <SolidColorBrush x:Key="PanelHeaderBrush" Color="#12151B"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#161A21"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#A9F1FE"/>
    <SolidColorBrush x:Key="AccentDimBrush" Color="#4FB8D6"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#7C8798"/>
    <SolidColorBrush x:Key="ChartTrackBrush" Color="#1E232B"/>
    <SolidColorBrush x:Key="ChartFillBrush" Color="#A9F1FE"/>
    <SolidColorBrush x:Key="HairlineBrush" Color="#FFFFFF" Opacity="0.09"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#FFFFFF" Opacity="0.07"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#A9F1FE" Opacity="0.14"/>
    <SolidColorBrush x:Key="DownBrush" Color="#5C8A69"/>
    <SolidColorBrush x:Key="UpBrush" Color="#C48B5E"/>

    <SolidColorBrush x:Key="BackgroundBrush" Color="#0A0C10"/>

    <FontFamily x:Key="MonoFont">Cascadia Code, Consolas, JetBrains Mono</FontFamily>
    <FontFamily x:Key="SansFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- Uppercase micro label (.collapsed-section-head / .board-title esdegeri) -->
    <Style x:Key="MicroLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="UnitLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style x:Key="MutedLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    </Style>

    <!-- Kart yuzeyi: .board-item esdegeri (yumusak kose + 1px kilcal cizgi) -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,13,16,14"/>
    </Style>

    <!-- Bar ray -->
    <Style x:Key="BarTrack" TargetType="Border">
        <Setter Property="Height" Value="4"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Background" Value="{StaticResource ChartTrackBrush}"/>
    </Style>
</ResourceDictionary>
