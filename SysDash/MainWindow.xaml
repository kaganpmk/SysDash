<Window x:Class="SysDash.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SysDash.Controls"
        xmlns:converters="clr-namespace:SysDash.Converters"
        Title="SysDash"
        WindowStyle="None"
        WindowState="Normal"
        Topmost="True"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Consolas"
        ShowInTaskbar="True"
        Loaded="OnLoaded"
        Closing="OnClosing">
    <Window.Resources>
        <converters:PercentToWidthMultiConverter x:Key="PercentToWidthConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Panel: Time left - Date right -->
        <Border Grid.Row="0"
                Background="{StaticResource CardBackgroundBrush}"
                Padding="30,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding CurrentTime}"
                           FontSize="72"
                        FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <TextBlock Text="{Binding CurrentDate}"
                               FontSize="26"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding CurrentDay}"
                               FontSize="20"
                               Foreground="{StaticResource AccentBrush}"
                               Opacity="0.85"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2x2 Grid -->
        <Grid Grid.Row="1"
                Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- CPU Card -->
            <Border Grid.Row="0"
                    Grid.Column="0"
                    Margin="8"
                    CornerRadius="12"
                    Background="{StaticResource CardBackgroundBrush}"
                    Padding="18,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="CPU"
                            FontSize="18"
                            FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"/>

                    <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="{Binding CpuUsageText}"
                                   FontSize="52"
                                FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CpuTemperatureText}"
                                   FontSize="24"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <controls:SparklineChart Grid.Row="2"
                                             Data="{Binding CpuSparklineData}"
                                             Height="50"
                            Margin="0,6,0,0"/>
                </Grid>
            </Border>

            <!-- GPU Card -->
            <Border Grid.Row="0"
                    Grid.Column="1"
                    Margin="8"
                    CornerRadius="12"
                    Background="{StaticResource CardBackgroundBrush}"
                    Padding="18,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="GPU"
                            FontSize="18"
                            FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"/>

                    <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="{Binding GpuUsageText}"
                                   FontSize="52"
                                FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding GpuTemperatureText}"
                                   FontSize="24"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- VRAM Bar -->
                    <Border Grid.Row="2"
                            x:Name="VramTrack"
                            Height="10"
                            Margin="4,6,4,0"
                            CornerRadius="3"
                            Background="{StaticResource ChartTrackBrush}">
                        <Border CornerRadius="3"
                                Background="{StaticResource AccentBrush}"
                                HorizontalAlignment="Left">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                                    <Binding Path="VramPercentage"/>
                                    <Binding Path="ActualWidth"
                                            ElementName="VramTrack"/>
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Border>

                    <TextBlock Grid.Row="3"
                            Text="{Binding VramUsageText}"
                               FontSize="13"
                               Foreground="{StaticResource TextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,3,0,0"/>
                </Grid>
            </Border>

            <!-- RAM Card -->
            <Border Grid.Row="1"
                    Grid.Column="0"
                    Margin="8"
                    CornerRadius="12"
                    Background="{StaticResource CardBackgroundBrush}"
                    Padding="18,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="RAM"
                            FontSize="18"
                            FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"/>

                    <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                            Margin="0,4,0,0">
                        <TextBlock Text="{Binding RamUsageText}"
                                   FontSize="22"
                                FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Center"/>
                        <controls:GaugeControl
                            Percentage="{Binding RamPercentage}"
                            Width="100"
                                Height="100"
                            Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Network Card -->
            <Border Grid.Row="1"
                    Grid.Column="1"
                    Margin="8"
                    CornerRadius="12"
                    Background="{StaticResource CardBackgroundBrush}"
                    Padding="18,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="AĞ / WIFI"
                            FontSize="18"
                            FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"/>

                    <Grid Grid.Row="1"
                            VerticalAlignment="Center"
                            Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="26"
                                    FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}">
                                <Run Text="▼ "
                                        Foreground="#5C8A69"
                                        FontSize="20"/>
                                <Run Text="{Binding DownloadSpeedText}"/>
                            </TextBlock>
                            <TextBlock FontSize="26"
                                    FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,4,0,0">
                                <Run Text="▲ "
                                        Foreground="#C48B5E"
                                        FontSize="20"/>
                                <Run Text="{Binding UploadSpeedText}"/>
                            </TextBlock>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Width="70"
                                Height="50"
                                CornerRadius="8"
                                Background="{StaticResource ChartTrackBrush}"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0">
                            <TextBlock Text="{Binding PingText}"
                                       FontSize="18"
                                    FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <controls:SparklineChart Grid.Row="2"
                                             Data="{Binding NetworkSparklineData}"
                                             Height="36"
                            Margin="0,4,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Bar: Uptime -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBackgroundBrush}"
                Padding="20,7">
            <TextBlock Text="{Binding UptimeText}"
                       FontSize="15"
                       Foreground="{StaticResource AccentBrush}"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
