<Window x:Class="SysDash.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SysDash.Controls"
        xmlns:converters="clr-namespace:SysDash.Converters"
        Title="SysDash"
        WindowStyle="None"
        WindowState="Normal"
        Topmost="True"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Consolas"
        ShowInTaskbar="True"
        Loaded="OnLoaded"
        Closing="OnClosing">
    <Window.Resources>
        <converters:PercentToWidthMultiConverter x:Key="PercentToWidthConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Panel: Time left - Date right -->
        <Border Grid.Row="0"
                Background="{StaticResource CardBackgroundBrush}"
                Padding="30,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding CurrentTime}"
                           FontSize="72"
                        FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <TextBlock Text="{Binding CurrentDate}"
                               FontSize="26"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding CurrentDay}"
                               FontSize="20"
                               Foreground="{StaticResource AccentBrush}"
                               Opacity="0.85"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2x2 Grid -->
        <Grid Grid.Row="1"
                Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- CPU Card -->
            <Border Grid.Row="0"
                    Grid.Column="0"
                    Margin="8"
                    CornerRadius="12"
                    Background="{StaticResource CardBackgroundBrush}"
                    Padding="18,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="CPU"
                            FontSize="18"
                            FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"/>

                    <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="{Binding CpuUsageText}"
                                   FontSize="52"
                                FontWeight="Bold"
